# ─── AI ──────────────────────────────────────────────────────────────
# Ollama Cloud (OpenAI-compatible). A local Ollama daemon works too:
#   OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=
# Light flash model for task understanding + matching rationale
OLLAMA_TEXT_MODEL=deepseek-v4.1-flash
# Multimodal model for photo evidence verification
OLLAMA_VISION_MODEL=gemma4:31b

# ─── PayPal Sandbox ──────────────────────────────────────────────────
# developer.paypal.com → Apps & Credentials → Sandbox → Default Application
# Leave blank to run the clearly-labelled checkout simulator.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Optional: "simulated" forces the labelled checkout simulator even when keys
# exist (useful for recordings or hosted previews without a buyer session).
# PAYPAL_MODE=simulated

# ─── Session ─────────────────────────────────────────────────────────
SESSION_SECRET=change-this-to-a-long-random-string

# ─── Optional ────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# HF_DATA_DIR=./data
